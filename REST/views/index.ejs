<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Quora</h1>
    <hr />
    <% for (post of posts){ %>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h4 class="content"><%= post.content %></h4>
            <button style="border-radius: 10px; font-size: 15px; padding: 5px 5px; color: black; background-color: whitesmoke;"><a href="http://localhost:8080/posts/<%= post.id %>">See in Detail</a></button>
            <button style="border-radius: 10px; font-size: 15px; padding: 5px 5px; color: black; background-color: whitesmoke;"><a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit Post</a></button>
            <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                <button style="border-radius: 10px; font-size: 15px; padding: 5px 5px; color: black; background-color: whitesmoke; cursor: pointer;">Delete Post</button>
            </form>
        </div>
    <% } %>
    <br />
    <button><a href="http://localhost:8080/posts/new">Create New Post</a></button>
</body>
</html>